# 采集产物：官方接口原始 JSON、meta、浏览器 profile 与验证截图（含账号 UID），禁止入库
/data/

# 报表产物：由 scripts/build-report.mjs 生成，固定输出到 .out/ 方便反复刷新同一路径
/out/
/.out/
/report.html

# 隔离 Chrome profile（--launch 模式会创建）
/.chrome-profile/

# 下面是随仓库分发的静态资产，补齐后应提交，不要加入忽略：
#   assets/vendor/echarts.min.js   ECharts 5.6.0（见 references/report-rules.md §7）
#   assets/avatars/                角色圆头像缓存
#   assets/items/                  角色/音擎/邦布图标缓存

# 测试产物（含真实昵称/UID，不入库）
docs/demo/
